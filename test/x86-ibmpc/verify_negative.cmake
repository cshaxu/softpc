if(NOT DEFINED CORPUS_ROOT OR NOT DEFINED PROBE_ROOT)
    message(FATAL_ERROR "CORPUS_ROOT and PROBE_ROOT are required")
endif()
function(expect_rejected suffix appended)
    set(expected "Forbidden x86-ibmpc edge")
    if(ARGC GREATER 2)
        set(expected "${ARGV2}")
    endif()
    set(probe "${PROBE_ROOT}/${suffix}")
    file(REMOVE_RECURSE "${probe}")
    file(COPY "${CORPUS_ROOT}/" DESTINATION "${probe}")
    file(APPEND "${probe}/CMakeLists.txt" "\n${appended}\n")
    if(ARGC GREATER 3)
        get_filename_component(parent "${probe}/${ARGV3}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(WRITE "${probe}/${ARGV3}" "${ARGV4}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCORPUS_ROOT=${probe}"
        -P "${probe}/verify_corpus.cmake" RESULT_VARIABLE result
        OUTPUT_QUIET ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "x86-ibmpc dependency gate accepted ${suffix}: ${error}")
    endif()
endfunction()
expect_rejected("base" "target_link_libraries(x86-ibmpc-product INTERFACE base)")
expect_rejected("mixed-case" "TaRgEt_LiNk_LiBrArIeS(x86-ibmpc-product PRIVATE base)")
expect_rejected("global-link" "LiNk_LiBrArIeS(types)" "Use explicit")
expect_rejected("link-property" "set_property(TARGET x86-ibmpc-product PROPERTY LINK_LIBRARIES types)" "Use explicit")
expect_rejected("root-source" "" "Unowned" "rogue.c" "void rogue(void);")
expect_rejected("nested-source" "" "Unowned" "product/nested/rogue.h" "void rogue(void);")
expect_rejected("raw-null" "" "Raw CRT vocabulary" "product/null.c" "void *p = NULL;")
expect_rejected("nested-build" "" "Forbidden x86-ibmpc edge" "product/CMakeLists.txt"
    "target_link_libraries(x86-ibmpc-product PRIVATE base)")
message(STATUS "x86-ibmpc dependency negative coverage: OK")
