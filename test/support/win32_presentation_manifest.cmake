if(NOT DEFINED SOFTPC_SOURCE_DIR)
    message(FATAL_ERROR "SOFTPC_SOURCE_DIR is required")
endif()

set(component_root "${SOFTPC_SOURCE_DIR}/src/lib")
set(manifest "${component_root}/MANIFEST.sha256")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Imported NXVM library manifest is missing")
endif()
file(SHA256 "${manifest}" manifest_hash)
string(TOUPPER "${manifest_hash}" manifest_hash)
if(NOT manifest_hash STREQUAL
    "01AFE9A5B66D9CFB6A67C6011616E574F920C8B60169C6F219E7B53BE2E019A2")
    message(FATAL_ERROR "Shared library manifest differs from the admitted T47 S3 corpus")
endif()
message(STATUS "Admitted T47 S2 shared library manifest is valid")
