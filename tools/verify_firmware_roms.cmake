function(softpc_verify_firmware_roms source_root)
    set(firmware_roms ${ARGN})
    set(manifest "${source_root}/docs/etc/evidence/softpc/xp-sp1-current-manifest.tsv")
    if(NOT EXISTS "${manifest}")
        message(FATAL_ERROR "Firmware ROM gate: missing XP manifest")
    endif()

    file(STRINGS "${manifest}" rows REGEX "^roms/(bios1[.]rom|bios4[.]rom|v7vga[.]rom)")
    list(LENGTH rows row_count)
    if(NOT row_count EQUAL 3)
        message(FATAL_ERROR "Firmware ROM gate: XP manifest must list exactly three embedded ROMs")
    endif()

    set(expected_paths bios1.rom bios4.rom v7vga.rom)
    foreach(rom IN LISTS firmware_roms)
        get_filename_component(name "${rom}" NAME)
        if(NOT name IN_LIST expected_paths)
            message(FATAL_ERROR "Firmware ROM gate: unexpected embedded input ${rom}")
        endif()
        if(NOT EXISTS "${rom}")
            message(FATAL_ERROR "Firmware ROM gate: missing ${rom}")
        endif()
        set(found FALSE)
        foreach(row IN LISTS rows)
            string(REPLACE "\t" ";" fields "${row}")
            list(GET fields 0 path)
            if(path STREQUAL "roms/${name}")
                list(GET fields 1 xp_hash)
                list(GET fields 2 subset_hash)
                list(GET fields 3 local_hash)
                list(GET fields 4 format)
                if(NOT format STREQUAL "binary" OR NOT xp_hash STREQUAL subset_hash
                    OR NOT xp_hash STREQUAL local_hash)
                    message(FATAL_ERROR "Firmware ROM gate: invalid XP identity for ${path}")
                endif()
                file(SHA256 "${rom}" actual_hash)
                if(NOT actual_hash STREQUAL xp_hash)
                    message(FATAL_ERROR "Firmware ROM gate: ${path} differs from pinned XP bytes")
                endif()
                set(found TRUE)
                break()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Firmware ROM gate: ${name} absent from XP manifest")
        endif()
    endforeach()
    message(STATUS "Firmware ROM gate verified: three byte-exact XP inputs")
endfunction()
