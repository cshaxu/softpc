# Publication proof: fresh compiler literals must reach the executable.
cmake_minimum_required(VERSION 3.23)
file(TIMESTAMP "${STAMP}" start "%s")
file(TIMESTAMP "${OBJECT}" compiled "%s")
if(start STREQUAL "" OR compiled STREQUAL "" OR compiled LESS start)
    message(FATAL_ERROR "Build timestamp object was not refreshed")
endif()
file(STRINGS "${OBJECT}" dates REGEX "^[A-Z][a-z][a-z] [ 0-9][0-9] [0-9][0-9][0-9][0-9]$")
file(STRINGS "${OBJECT}" times REGEX "^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$")
list(LENGTH dates date_count)
list(LENGTH times time_count)
file(TIMESTAMP "${OBJECT}" expected_date "%b %d %Y")
string(REGEX REPLACE " 0([0-9]) " "  \\1 " expected_date "${expected_date}")
if(NOT date_count EQUAL 1 OR NOT time_count EQUAL 1 OR NOT dates STREQUAL expected_date)
    message(FATAL_ERROR "Missing or stale compiler timestamp: ${dates} ${times}")
endif()
file(READ "${EXE}" published HEX)
foreach(value IN ITEMS "${dates}" "${times}")
    string(HEX "${value}" encoded)
    string(FIND "${published}" "${encoded}00" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Published EXE does not contain this build timestamp")
    endif()
endforeach()
message(STATUS "Published build timestamp: ${dates} ${times}")
