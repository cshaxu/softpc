cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED SOFTPC_SOURCE_DIR OR NOT DEFINED SELF_TEST_ROOT)
    message(FATAL_ERROR "SOFTPC_SOURCE_DIR and SELF_TEST_ROOT are required")
endif()
file(MAKE_DIRECTORY "${SELF_TEST_ROOT}")
file(REAL_PATH "${SELF_TEST_ROOT}" parent)
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(fixture "${parent}/xp-mirror-${suffix}")
set(source "${fixture}/src/app-softpc/softpc.new")
set(evidence "${fixture}/docs/etc/evidence/softpc")
file(MAKE_DIRECTORY "${source}" "${evidence}")
set(manifest "${evidence}/xp-sp1-current-manifest.tsv")
set(header "# xp-sp1 a2f6d7c93aa4f11efc51147566d5961c59a8ef89 1\npath\txp_raw_sha256\txp_subset_sha256\tlocal_sha256\tformat\tselection\tdisposition\n")
string(SHA256 hash "probe\n")
set(row "probe.c\t${hash}\t${hash}\t${hash}\ttext\twhole\tXP_SUBSET_IDENTICAL\n")
file(WRITE "${source}/probe.c" "probe\n")
file(WRITE "${manifest}" "${header}${row}")
function(check expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOFTPC_SOURCE_DIR=${fixture}"
        -P "${SOFTPC_SOURCE_DIR}/tools/checks/xp_mirror.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "pass")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Expected valid mirror: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected ${expected}: ${output}${error}")
    endif()
endfunction()
check(pass)
file(WRITE "${source}/probe.c" "changed\n")
check("unreviewed change")
file(REMOVE "${source}/probe.c")
check("missing file")
file(WRITE "${source}/probe.c" "probe\n")
file(WRITE "${source}/extra.c" "extra\n")
check("missing or extra paths")
file(REMOVE "${source}/extra.c")
file(WRITE "${manifest}" "${header}${row}${row}")
check("invalid or duplicate path")
string(REPLACE "probe.c" "../probe.c" bad "${row}")
file(WRITE "${manifest}" "${header}${bad}")
check("invalid or duplicate path")
string(REPLACE "XP_SUBSET_IDENTICAL" "REVIEWED_LOCAL_PATCH" bad "${row}")
file(WRITE "${manifest}" "${header}${bad}")
check("inconsistent patch identity")
string(REPLACE "a2f6d7c93aa4f11efc51147566d5961c59a8ef89" "unapproved" bad "${header}")
file(WRITE "${manifest}" "${bad}${row}")
check("invalid pinned identity")
# Exercise the exact-byte branch independently of text newline normalization.
file(WRITE "${source}/probe.c" "probe\r\n")
file(SHA256 "${source}/probe.c" binary_hash)
file(WRITE "${manifest}" "${header}probe.c\t${binary_hash}\t${binary_hash}\t${binary_hash}\tbinary\twhole\tXP_SUBSET_IDENTICAL\n")
check(pass)
file(WRITE "${source}/probe.c" "probe")
check("unreviewed change")
file(REMOVE_RECURSE "${fixture}")
message(STATUS "XP mirror gate negative and newline contracts: OK")
