cmake_minimum_required(VERSION 3.23)
function(verify_presets text)
    string(JSON count LENGTH "${text}" configurePresets)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON name GET "${text}" configurePresets ${index} name)
        string(JSON generator ERROR_VARIABLE missing GET "${text}" configurePresets ${index} generator)
        if(generator MATCHES "^Ninja")
            string(JSON directory GET "${text}" configurePresets ${index} binaryDir)
            if(NOT name MATCHES "^ninja-gcc-(x64|x86)-release$")
                message(FATAL_ERROR "Unexpected additional persistent Ninja tree: ${name}")
            endif()
            set(expected_directory "\${sourceDir}/build/.ninja/gcc-${CMAKE_MATCH_1}-release")
            if(NOT directory STREQUAL expected_directory)
                message(FATAL_ERROR "Ninja preset ${name} escapes its persistent root")
            endif()
            string(JSON launcher GET "${text}" configurePresets ${index} cacheVariables CMAKE_C_COMPILER_LAUNCHER)
            if(NOT launcher STREQUAL "")
                message(FATAL_ERROR "Plain Ninja preset must explicitly clear a stale launcher")
            endif()
        elseif(name MATCHES "^ninja-ccache-")
            string(JSON directory ERROR_VARIABLE missing GET "${text}" configurePresets ${index} binaryDir)
            string(JSON parent GET "${text}" configurePresets ${index} inherits)
            string(JSON launcher GET "${text}" configurePresets ${index} cacheVariables CMAKE_C_COMPILER_LAUNCHER)
            string(REPLACE "ninja-ccache-" "ninja-" expected_parent "${name}")
            if(NOT missing OR NOT parent STREQUAL expected_parent OR NOT launcher STREQUAL "ccache")
                message(FATAL_ERROR "ccache preset must reuse its plain architecture tree")
            endif()
        endif()
    endforeach()
endfunction()

file(READ "${SOFTPC_SOURCE_DIR}/CMakePresets.json" presets)
verify_presets("${presets}")
if(DEFINED SELF_TEST_ROOT)
    file(MAKE_DIRECTORY "${SELF_TEST_ROOT}")
    foreach(kind IN ITEMS escape duplicate stale)
        if(kind STREQUAL escape)
            string(JSON invalid SET "${presets}" configurePresets 2 binaryDir "\"\${sourceDir}/build/rogue\"")
        elseif(kind STREQUAL duplicate)
            string(JSON invalid SET "${presets}" configurePresets 4 binaryDir "\"duplicate\"")
        else()
            string(JSON invalid SET "${presets}" configurePresets 2 cacheVariables CMAKE_C_COMPILER_LAUNCHER "\"ccache\"")
        endif()
        file(MAKE_DIRECTORY "${SELF_TEST_ROOT}/${kind}")
        file(WRITE "${SELF_TEST_ROOT}/${kind}/CMakePresets.json" "${invalid}")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOFTPC_SOURCE_DIR=${SELF_TEST_ROOT}/${kind}"
            -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
        if(result EQUAL 0)
            message(FATAL_ERROR "Invalid build-cache fixture ${kind} was accepted")
        endif()
    endforeach()
    set(CMAKE_C_COMPILER_LAUNCHER ccache)
    set(CMAKE_SOURCE_DIR "${SOFTPC_SOURCE_DIR}")
    include("${CMAKE_CURRENT_LIST_DIR}/../build_cache.cmake")
    foreach(required IN ITEMS "${CMAKE_COMMAND}" -E env
            "CCACHE_DIR=${SOFTPC_SOURCE_DIR}/build/.ccache"
            "CCACHE_TEMPDIR=${SOFTPC_SOURCE_DIR}/build/.ccache/tmp" "CCACHE_MAXSIZE=5G" ccache)
        if(NOT required IN_LIST CMAKE_C_COMPILER_LAUNCHER)
            message(FATAL_ERROR "Generated compiler launcher lacks ${required}")
        endif()
    endforeach()
    file(WRITE "${SELF_TEST_ROOT}/guard.cmake"
        "set(CMAKE_SOURCE_DIR [=[${SOFTPC_SOURCE_DIR}]=])\n"
        "set(CMAKE_BINARY_DIR [=[${SELF_TEST_ROOT}/wrong-tree]=])\n"
        "set(CMAKE_GENERATOR Ninja)\nset(CMAKE_SIZEOF_VOID_P 8)\n"
        "include([=[${CMAKE_CURRENT_LIST_DIR}/../build_cache.cmake]=])\nsoftpc_verify_ninja_tree()\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${SELF_TEST_ROOT}/guard.cmake"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE diagnostic)
    if(result EQUAL 0 OR NOT diagnostic MATCHES "Use the canonical build/[.]ninja")
        message(FATAL_ERROR "Actual configure guard accepted a noncanonical tree")
    endif()
endif()
