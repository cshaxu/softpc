cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED SOFTPC_SOURCE_DIR)
    message(FATAL_ERROR "SOFTPC_SOURCE_DIR is required")
endif()
set(root "${SOFTPC_SOURCE_DIR}/src/app-softpc/softpc.new")
set(manifest "${SOFTPC_SOURCE_DIR}/docs/etc/evidence/softpc/xp-sp1-current-manifest.tsv")
file(STRINGS "${manifest}" rows)
list(POP_FRONT rows header columns)
if(NOT header MATCHES "^# xp-sp1 a2f6d7c93aa4f11efc51147566d5961c59a8ef89 ([1-9][0-9]*)$")
    message(FATAL_ERROR "XP mirror: invalid pinned identity")
endif()
set(expected_count "${CMAKE_MATCH_1}")
if(NOT columns STREQUAL "path\txp_raw_sha256\txp_subset_sha256\tlocal_sha256\tformat\tselection\tdisposition")
    message(FATAL_ERROR "XP mirror: invalid columns")
endif()
set(paths)
set(previous "")
foreach(row IN LISTS rows)
    string(REPLACE "\t" ";" fields "${row}")
    list(LENGTH fields count)
    if(NOT count EQUAL 7)
        message(FATAL_ERROR "XP mirror: invalid row")
    endif()
    list(GET fields 0 path)
    if(NOT path MATCHES "^[A-Za-z0-9_./+-]+$" OR path MATCHES "(^/|(^|/)\.\.(/|$))"
        OR path IN_LIST paths OR (NOT previous STREQUAL "" AND NOT previous STRLESS path))
        message(FATAL_ERROR "XP mirror: invalid or duplicate path ${path}")
    endif()
    foreach(index RANGE 1 3)
        list(GET fields ${index} hash)
        string(LENGTH "${hash}" length)
        if(NOT length EQUAL 64 OR NOT hash MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "XP mirror: invalid hash ${path}")
        endif()
    endforeach()
    list(GET fields 2 subset)
    list(GET fields 3 expected)
    list(GET fields 4 format)
    list(GET fields 5 selection)
    list(GET fields 6 disposition)
    if(NOT format MATCHES "^(text|binary)$" OR NOT selection MATCHES "^(whole|s3|s4|s5|t93-s6|t93-s8)$"
        OR NOT disposition MATCHES "^(XP_SUBSET_IDENTICAL|REVIEWED_LOCAL_PATCH|PRESERVED_LOCAL_PATCH)$")
        message(FATAL_ERROR "XP mirror: invalid disposition ${path}")
    endif()
    if((disposition STREQUAL "XP_SUBSET_IDENTICAL" AND NOT expected STREQUAL subset)
        OR (NOT disposition STREQUAL "XP_SUBSET_IDENTICAL" AND expected STREQUAL subset))
        message(FATAL_ERROR "XP mirror: inconsistent patch identity ${path}")
    endif()
    if(NOT EXISTS "${root}/${path}" OR IS_DIRECTORY "${root}/${path}")
        message(FATAL_ERROR "XP mirror: missing file ${path}")
    endif()
    if(format STREQUAL "text")
        file(READ "${root}/${path}" content)
        string(REPLACE "\r\n" "\n" content "${content}")
        string(SHA256 actual "${content}")
    else()
        file(SHA256 "${root}/${path}" actual)
    endif()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "XP mirror: unreviewed change ${path}")
    endif()
    list(APPEND paths "${path}")
    set(previous "${path}")
endforeach()
list(LENGTH paths count)
file(GLOB_RECURSE actual_paths RELATIVE "${root}" "${root}/*")
list(SORT actual_paths)
if(NOT count EQUAL expected_count OR NOT paths STREQUAL actual_paths)
    message(FATAL_ERROR "XP mirror: missing or extra paths")
endif()
message(STATUS "XP mirror verified: ${count} local bodies; fixed upstream/subset provenance recorded")
